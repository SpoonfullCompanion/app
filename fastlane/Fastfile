default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)

def ios_app_identifier
  ENV["IOS_APP_IDENTIFIER"] || "com.spoonfull.app"
end

def provisioning_profile_name
  ENV["IOS_PROVISIONING_PROFILE_NAME"]
end

def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]

  return nil unless key_id && issuer_id && key_content_base64

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content_base64,
    is_key_content_base64: true
  )
end

# Apply manual signing to the App target ONLY. With CocoaPods, the Pods project
# has its own framework targets (Capacitor, Pods-App, ...) that don't support
# provisioning profiles, so signing must not be forced globally.
def configure_app_signing
  return unless provisioning_profile_name

  update_code_signing_settings(
    use_automatic_signing: false,
    path: File.join(PROJECT_ROOT, "ios/App/App.xcodeproj"),
    team_id: ENV["APPLE_TEAM_ID"],
    code_sign_identity: "iPhone Distribution",
    profile_name: provisioning_profile_name,
    targets: ["App"],
    build_configurations: ["Release"]
  )
end

def build_options
  options = {
    workspace: File.join(PROJECT_ROOT, "ios/App/App.xcworkspace"),
    scheme: "App",
    clean: true,
    export_method: "app-store"
  }

  xcargs = []

  if ENV["APPLE_TEAM_ID"]
    options[:export_team_id] = ENV["APPLE_TEAM_ID"]
    xcargs << "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}"
  end

  if provisioning_profile_name
    # NB: signing is applied per-target in configure_app_signing, NOT here.
    # A global PROVISIONING_PROFILE_SPECIFIER would also hit the Pods framework
    # targets and fail with "does not support provisioning profiles".
    options[:export_options] = {
      signingStyle: "manual",
      provisioningProfiles: {
        ios_app_identifier => provisioning_profile_name
      }
    }
  end

  options[:xcargs] = xcargs.join(" ") unless xcargs.empty?

  options
end

platform :ios do
  desc "Build fresh web assets and sync the Capacitor iOS project"
  lane :prepare do
    Dir.chdir(PROJECT_ROOT) do
      if File.exist?("package-lock.json")
        sh("npm ci")
      else
        sh("npm install")
      end
      sh("npm run build")
      # `cap sync` runs `pod install`; run it outside Fastlane's Bundler
      # environment, or CocoaPods inherits BUNDLE_GEMFILE/RUBYOPT and dies with
      # Bundler::GemNotFound looking for Fastlane's gems.
      Bundler.with_unbundled_env do
        sh("npx cap sync ios")
      end
    end
  end

  desc "Build and upload a TestFlight build"
  lane :beta do
    prepare
    api_key = app_store_connect_api_key_from_env

    configure_app_signing
    build_app(build_options)

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "CI lane for GitHub Actions TestFlight uploads"
  lane :ci_beta do
    api_key = app_store_connect_api_key_from_env
    UI.user_error!("Missing App Store Connect API key env vars.") unless api_key

    prepare
    configure_app_signing
    build_app(build_options)

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
